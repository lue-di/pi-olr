{
  "name": "pi-onelastrouter",
  "version": "0.1.0",
  "description": "OneLastRouter provider for Pi Coding Agent — live model discovery via /v1/models, calls routed through OpenAI Chat Completions",
  "author": "luedi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lue-di/pi-olr.git"
  },
  "homepage": "https://github.com/lue-di/pi-olr#readme",
  "bugs": {
    "url": "https://github.com/lue-di/pi-olr/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "onelastrouter",
    "openai",
    "provider"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx scripts/test-mapping.ts",
    "probe": "tsx scripts/probe.ts",
    "check": "tsc --noEmit && eslint src && prettier --check ."
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": ">=0.80.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {}
}
